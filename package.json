{
  "name": "asistente-tramites",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that guides people through Spanish government websites: it navigates, the person fills in and submits.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:safari": "node build.mjs --safari",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "map": "tsx scripts/map-site.ts",
    "check-plugins": "tsx scripts/check-plugins.ts",
    "pack:web": "node build.mjs && rm -f web/public/asistente-tramites.zip && cd dist && zip -qr ../web/public/asistente-tramites.zip .",
    "serve:local": "node --env-file=web/.env.local --import tsx scripts/serve-local.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "dompurify": "^3.4.18",
    "marked": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
